{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_text"
  ],
  "properties": {
    "request_text": {
      "type": "string",
      "minLength": 3,
      "maxLength": 2000
    },
    "marketplace": {
      "enum": [
        "pinduoduo.com"
      ]
    },
    "destination_country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "destination_region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "comparison_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "maximum_budget": {
      "type": "string",
      "pattern": "^(unknown|\\d+(?:\\.\\d{1,2})?)$"
    },
    "desired_condition": {
      "enum": [
        "new",
        "open-box",
        "refurbished",
        "used",
        "any"
      ]
    },
    "buying_formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "enum": [
          "fixed-price",
          "group-buy",
          "member-price",
          "subscription",
          "unknown"
        ]
      }
    },
    "detail_limit": {
      "type": "integer",
      "minimum": 3,
      "maximum": 8
    }
  }
}
