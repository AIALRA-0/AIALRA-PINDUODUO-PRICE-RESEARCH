{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan",
    "access",
    "collection_status",
    "rounds",
    "candidates"
  ],
  "properties": {
    "plan": {
      "type": "object"
    },
    "access": {
      "type": "object"
    },
    "collection_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stop_reason",
        "blocked_reasons"
      ],
      "properties": {
        "stop_reason": {
          "enum": [
            "plan-completed",
            "saturated",
            "round-limit",
            "candidate-limit",
            "time-limit",
            "partial"
          ]
        },
        "blocked_reasons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "round_id",
          "query",
          "sort_mode",
          "source_backend",
          "page_numbers",
          "retrieved_at",
          "result_count"
        ],
        "properties": {
          "round_id": {
            "type": "string",
            "pattern": "^round-[1-5]$"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "sort_mode": {
            "enum": [
              "relevance",
              "price-ascending",
              "newest"
            ]
          },
          "source_backend": {
            "enum": [
              "aialra-shopping-browser"
            ]
          },
          "page_numbers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64
          },
          "result_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 160
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "platform_item_id",
          "round_id",
          "query",
          "sort_mode",
          "source_backend",
          "page_number",
          "result_rank",
          "title",
          "displayed_price",
          "currency",
          "buying_formats",
          "condition_summary",
          "seller_name",
          "shipping_text",
          "image_url",
          "url",
          "retrieved_at"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "platform_item_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{5,40}$"
          },
          "round_id": {
            "type": "string",
            "pattern": "^round-[1-5]$"
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "sort_mode": {
            "enum": [
              "relevance",
              "price-ascending",
              "newest"
            ]
          },
          "source_backend": {
            "enum": [
              "aialra-shopping-browser"
            ]
          },
          "page_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "result_rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "displayed_price": {
            "type": "string",
            "pattern": "^(unknown|\\d+(?:\\.\\d{1,2})?)$"
          },
          "currency": {
            "type": "string",
            "pattern": "^(unknown|[A-Z]{3})$"
          },
          "buying_formats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "enum": [
                "fixed-price",
                "group-buy",
                "member-price",
                "subscription",
                "unknown"
              ]
            }
          },
          "condition_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "seller_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "shipping_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "image_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "url": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          },
          "retrieved_at": {
            "type": "string",
            "minLength": 20,
            "maxLength": 64
          }
        }
      }
    }
  }
}
